    {
        "id": "fn_normalize_mutex_01",
        "type": "function",
        "z": "tab_audio_switch_01",
        "name": "Normalize + Mutex",
        "func": "var src = (msg.payload || \"\").toString().trim().toLowerCase();\nvar allowed = { tv: true, spotify: true, off: true };\n\nif (!allowed[src]) {\n  node.warn(\"Ignoring unknown source: \" + src);\n  return null;\n}\n\nvar switching = flow.get(\"switching\") || false;\nvar startedAt = flow.get(\"switching_started_at\") || 0;\nvar now = Date.now();\n\n// Se travou por mais de 10s, libera sozinho\nif (switching && (now - startedAt) > 10000) {\n  node.warn(\"Mutex stale (>10s). Auto-unlocking.\");\n  switching = false;\n  flow.set(\"switching\", false);\n}\n\nif (switching) {\n  node.warn(\"Switch in progress. Dropping request: \" + src);\n  return null;\n}\n\nflow.set(\"switching\", true);\nflow.set(\"switching_started_at\", now);\n\nvar current = (flow.get(\"current\") || \"\").toString();\nif (current === src) {\n  flow.set(\"switching\", false);\n  return null;\n}\n\nmsg.payload = src;\nmsg.src = src;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 140,
        "wires": [
            [
                "sw_route_01"
            ]
        ]
    },
    {
        "id": "sw_route_01",
        "type": "switch",
        "z": "tab_audio_switch_01",
        "name": "Route",
        "property": "src",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "tv",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "spotify",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "off",
                "vt": "str"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 3,
        "x": 520,
        "y": 140,
        "wires": [
